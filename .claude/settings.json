{   
    "disableClaudeAiConnectors": true,
    "disableWorkflows": true,
    "disableArtifact": true,
    "permissions": {
        "deny": [
            "NotebookEdit",
            "CronCreate",
            "CronDelete",
            "CronList",
            "EnterPlanMode",
            "ExitPlanMode",
            "PushNotification",
            "RemoteTrigger",
            "ReportFindings",
            "ScheduleWakeup",
            "AskUserQuestion",
            "SendFeedback"
        ],
        "allow": ["Bash(gh pr merge:*)", "Bash(gh issue comment:*)", "Bash(gh issue close:*)"]
    },
    "statusLine": {
        "type": "command",
        "command": "npx ccstatusline@latest"
    }
}